# Backend Environment Variables
# Copy this file to .env and fill in your values

# Secret key for JWT token signing — change this in production!
JWT_SECRET=smartagro_v3_change_in_production

# Port the backend Flask server will run on
PORT=5000

# Optional: LlamaParse API key for better PDF parsing
# Get yours at: https://cloud.llamaindex.ai/
# LLAMA_CLOUD_API_KEY=llx-your-key-here
